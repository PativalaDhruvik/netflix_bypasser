{
    "manifest_version": 3,
    "name": "Tobito Netflix-Bypass",
    "version": "1.1",
    "description": "Blocks Netflix household verification.",
    "permissions": [
        "tabs",
        "webNavigation",
        "scripting",
        "storage",
        "declarativeNetRequest",
        "webRequest",
        "webRequestBlocking"
    ],
    "host_permissions": [
        "*://*.netflix.com/*",
        "*://web.prod.cloud.netflix.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.netflix.com/*"
            ],
            "js": [
                "inject_early.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": false
        }
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "flixbypass@example.com",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}